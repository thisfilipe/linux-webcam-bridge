#!/usr/bin/python3 -I
"""Root helper: reset one positively identified Jieli 1224:2a25, no arguments."""
import errno
import fcntl
import os
from pathlib import Path
import signal
import stat
import struct
import sys
import time

VID, PID = 0x1224, 0x2A25
USBDEVFS_RESET = (ord("U") << 8) | 20
LOCK = "/run/lock/jieli-usb-reset.lock"
MIN_INTERVAL = 8.0


def discover():
    matches = []
    for directory in Path("/sys/bus/usb/devices").iterdir():
        try:
            if int((directory / "idVendor").read_text().strip(), 16) != VID:
                continue
            if int((directory / "idProduct").read_text().strip(), 16) != PID:
                continue
            bus = int((directory / "busnum").read_text())
            address = int((directory / "devnum").read_text())
        except (OSError, ValueError):
            continue
        if 1 <= bus <= 255 and 1 <= address <= 127:
            matches.append((directory.name, bus, address,
                            Path(f"/dev/bus/usb/{bus:03}/{address:03}")))
    if len(matches) != 1:
        raise RuntimeError(f"Expected exactly one Jieli 1224:2a25; found {len(matches)}")
    return matches[0]


def open_verified(device):
    _, bus, address, path = device
    fd = os.open(path, os.O_RDWR | os.O_CLOEXEC | os.O_NOFOLLOW)
    try:
        info = os.fstat(fd)
        if not stat.S_ISCHR(info.st_mode) or os.major(info.st_rdev) != 189:
            raise RuntimeError("Target is not a USB character device")
        if os.minor(info.st_rdev) != (bus - 1) * 128 + address - 1:
            raise RuntimeError("USB address changed before opening")
        descriptor = os.read(fd, 18)
        if len(descriptor) != 18 or descriptor[:2] != b"\x12\x01":
            raise RuntimeError("Invalid USB device descriptor")
        if struct.unpack_from("<HH", descriptor, 8) != (VID, PID):
            raise RuntimeError("Opened device is not Jieli 1224:2a25")
        return fd, info
    except BaseException:
        os.close(fd)
        raise


def reset():
    lock_fd = os.open(LOCK, os.O_RDWR | os.O_CREAT | os.O_CLOEXEC | os.O_NOFOLLOW, 0o600)
    try:
        info = os.fstat(lock_fd)
        if (info.st_uid != 0 or not stat.S_ISREG(info.st_mode)
                or info.st_nlink != 1 or info.st_mode & 0o022):
            raise RuntimeError("Unsafe reset lock file")
        fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        previous = os.read(lock_fd, 128).strip()
        now = time.monotonic()
        if previous and now - float(previous) < MIN_INTERVAL:
            raise RuntimeError("Reset cooldown: wait at least eight seconds between attempts")
        device = discover()
        fd, before = open_verified(device)
        try:
            os.lseek(lock_fd, 0, os.SEEK_SET)
            os.ftruncate(lock_fd, 0)
            os.write(lock_fd, str(now).encode("ascii"))
            try:
                fcntl.ioctl(fd, USBDEVFS_RESET, 0)
            except OSError as error:
                if error.errno != errno.ENODEV:
                    raise
                # Some devices reenumerate and invalidate the old descriptor.
                deadline = time.monotonic() + 3
                while time.monotonic() < deadline:
                    time.sleep(0.1)
                    try:
                        current = discover()
                        if current[3].stat().st_ino != before.st_ino or current[1:3] != device[1:3]:
                            check_fd, _ = open_verified(current)
                            os.close(check_fd)
                            print(f"Jieli reenumerated at {current[1]:03}/{current[2]:03}; capture must validate recovery")
                            return
                    except (OSError, RuntimeError):
                        continue
                raise
            print(f"Jieli USB reset completed at {device[1]:03}/{device[2]:03}")
        finally:
            os.close(fd)
    finally:
        os.close(lock_fd)


def alarm_timeout(signum, frame):
    raise TimeoutError("Jieli reset exceeded eight seconds")


def main():
    if len(sys.argv) != 1:
        raise SystemExit("This helper accepts no arguments")
    if os.geteuid() != 0:
        raise SystemExit("This installed helper requires its narrowly scoped sudo rule")
    signal.signal(signal.SIGALRM, alarm_timeout)
    signal.alarm(8)
    try:
        reset()
    except (OSError, RuntimeError, ValueError, TimeoutError) as error:
        print(f"Jieli reset failed: {error}", file=sys.stderr)
        return 1
    finally:
        signal.alarm(0)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
